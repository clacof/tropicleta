# ---------- Base ----------
# Sin DATABASE_URL se usa una BD embebida (PGlite en ./.data) con contenido demo. Para Postgres real:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/tropicleta
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Panel /admin (en desarrollo, sin estas variables la clave es "tropicleta") ----------
ADMIN_PASSWORD=cambia-esta-clave
SESSION_SECRET=una-cadena-larga-y-aleatoria-de-32-caracteres

# ---------- Emails (Resend) — sin API key se muestran en consola ----------
RESEND_API_KEY=
EMAIL_FROM="Tropicleta <hola@tropicleta.com>"
ADMIN_EMAIL=

# ---------- Webpay Plus ----------
# Sin TBK_ENV=production usa el ambiente de integración con credenciales de prueba del SDK
TBK_ENV=integration
TBK_COMMERCE_CODE=
TBK_API_KEY=

# ---------- Mercado Pago (opcional; sin token el método aparece como "Próximamente") ----------
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SANDBOX=0

# ---------- Despacho (CLP) — POR CONFIRMAR con Tropicleta ----------
NEXT_PUBLIC_SHIPPING_TIERRA_AMARILLA=2000
NEXT_PUBLIC_SHIPPING_PAIPOTE=3000
NEXT_PUBLIC_SHIPPING_COPIAPO=4000
